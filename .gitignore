/vcpkg_installed/
/.build/
/Project_Tarkov/packages/
**/x64/
**/x86/
**/.vs/

# Python bytecode cache
__pycache__/
*.py[cod]

# Local raid loot records
**/Saves/

# Local compiler/debugger products (do not ignore Wavefront model *.obj globally)
*.pdb
*.ilk
*.pch
*.ipch
*.vcxproj.user
*.suo
*.VC.db
*.VC.VC.opendb

# Licensed animation files stay local; CC0 assets and provenance remain trackable.
/Assets/Animations/Characters/Imported/Mixamo/*.fbx
/Assets/_Archive/**/*.fbx
/Assets/_Archive/**/*.zip

# Generated copies and recovery backups stay local; keep their move/source records.
/Assets/_Archive/BuildCopies/**/*.anim
/Assets/_Archive/BuildCopies/**/*.mesh
/Assets/_Archive/BuildCopies/**/*.png
/Assets/_Archive/BuildCopies/**/import.json
/Assets/_Archive/Characters/*/BeforeMeshyReplacement/
/Assets/_Archive/Characters/MeshyReplacement/

# Investigated files with conflicting license notices are not published.
/Assets/_Archive/Characters/BaseBodies/MakeHuman/735/*.obj
/Assets/_Archive/Characters/BaseBodies/MakeHuman/735/*.proxy
/Assets/_Archive/Characters/BaseBodies/MakeHuman/880/*.obj
/Assets/_Archive/Characters/BaseBodies/MakeHuman/880/*.proxy
